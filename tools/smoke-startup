#!/usr/bin/env python3
"""Compare cold and prepared Firefox startup using an authorized test-profile copy."""
import argparse
import asyncio
import json
from pathlib import Path
import shutil
import sys
import tempfile
import time
from types import SimpleNamespace

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "browser"))
from companion import Companion
from launch import candidates

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--profile", type=Path, required=True)
parser.add_argument("--firefox", default=next(iter(candidates()), ""))
parser.add_argument("--ffmpeg", default=shutil.which("ffmpeg"))
parser.add_argument("--mode", choices=["native", "flatpak"], default="native")
parser.add_argument("--track", default="47683510")
arguments = parser.parse_args()


async def measure(state):
    with tempfile.TemporaryDirectory(prefix="pg-qbz-startup-") as temporary:
        directory = Path(temporary)
        profile = directory / "firefox"
        shutil.copytree(arguments.profile, profile, ignore=shutil.ignore_patterns(
            "lock", ".parentlock", "parent.lock", "cache2", "startupCache", "thumbnails"))
        companion = Companion(SimpleNamespace(
            data=directory / "data", cache=directory / "cache", port=0,
            profile=profile, firefox=arguments.firefox, mode=arguments.mode,
            managed=True, ffmpeg=arguments.ffmpeg))
        try:
            # Match an authenticated plugin after its idle browser was closed.
            await companion.account()
            await companion.browser.close()
            companion.browser = None
            warming_started = time.monotonic()
            if state == "warm":
                await companion.warm_browser()
                if companion.metrics["warm_ready"] != 1:
                    raise RuntimeError("Firefox did not finish preparing")
            warming_seconds = time.monotonic() - warming_started
            started = time.monotonic()
            response = await companion.resolve({"track": arguments.track, "quality": 27})
            resolved = time.monotonic()
            if response.status != 200:
                raise RuntimeError("Track resolution failed")
            job = companion.jobs[(arguments.track, 27)]
            async with job.changed:
                await asyncio.wait_for(job.changed.wait_for(
                    lambda: job.available > 44 or job.finished.is_set()), 30)
            if job.error or job.available <= 44:
                raise RuntimeError("No PCM received: " + job.error_code)
            return {
                "state": state,
                "warm_seconds": round(warming_seconds, 3),
                "resolve_seconds": round(resolved - started, 3),
                "first_pcm_seconds": round(time.monotonic() - started, 3),
                "sample_rate": job.format["sample_rate"], "bits": job.format["bits"],
            }
        finally:
            await companion.close()


async def main():
    results = []
    for state in ["cold", "warm", "warm", "cold"]:
        results.append(await measure(state))
    print(json.dumps(results, indent=2))


asyncio.run(main())
