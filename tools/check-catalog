#!/usr/bin/env python3
"""Read catalog pages in a temporary profile; never print account state or play audio."""
import argparse
import json
import pathlib
import select
import shutil
import subprocess
import tempfile
import time

parser = argparse.ArgumentParser()
parser.add_argument("binary", type=pathlib.Path)
parser.add_argument("account", type=pathlib.Path)
args = parser.parse_args()
with tempfile.TemporaryDirectory(prefix="plugin-catalog-") as directory:
    stage = pathlib.Path(directory)
    (stage / "cache").mkdir()
    shutil.copyfile(args.account, stage / "account.json")
    (stage / "account.json").chmod(0o600)
    process = subprocess.Popen([str(args.binary.resolve())], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)
    serial = 0
    def call(method, params):
        global serial
        serial += 1
        started = time.monotonic()
        process.stdin.write(json.dumps({"jsonrpc":"2.0", "id":serial, "method":method, "params":params}) + "\n")
        process.stdin.flush()
        if not select.select([process.stdout], [], [], 120)[0]:
            raise RuntimeError("Catalog request timed out")
        reply = json.loads(process.stdout.readline())
        if "error" in reply:
            print(json.dumps({"method":method,"ref":params.get("ref"),"error_code":reply["error"].get("code")}))
            raise RuntimeError("Catalog request failed; response contents withheld")
        result = reply["result"]
        if result.get("next") and params.get("ref") != result["next"]:
            print(json.dumps({"next":result["next"]}))
        print(json.dumps({"method":method,"ref":params.get("ref"),"seconds":round(time.monotonic()-started,2),"shelves":[{"id":s.get("id"),"count":len(s.get("items",[])),"error":bool(s.get("error"))} for s in result.get("shelves",[])],"items":len(result.get("items",[])),"tracks":len(result.get("tracks",[])) if isinstance(result.get("tracks",[]),list) else result.get("tracks",0)}))
        return result
    try:
        call("initialize", {"protocol":1,"locale":"en","playback_events":1,"data_dir":str(stage),"cache_dir":str(stage / "cache")})
        home = call("page.get", {"ref":"discover:home"})
        call("page.get", {"ref":"discover:editors"})
        personal = call("page.get", {"ref":"discover:foryou"})
        call("library.list", {"kind":"playlists","limit":500})
        call("library.list", {"kind":"labels","limit":500})
        album = next(i for s in home.get("shelves",[]) for i in s.get("items",[]) if i.get("kind")=="album")
        detail = call("album.get", {"ref":album["ref"]})
        call("page.get", {"ref":album["ref"]})
        for field in ["artist_ref","label_ref"]:
            if detail["album"].get(field):
                entity = call("page.get", {"ref":detail["album"][field]})
                for tab in entity.get("tabs",[]): call("page.get", {"ref":tab["ref"]})
                for shelf in entity.get("shelves",[]):
                    if shelf.get("more"):
                        listing = call("page.get", {"ref":shelf["more"]})
                        if listing.get("next"): call("page.get", {"ref":listing["next"]})
        for shelf in home.get("shelves",[]):
            if shelf.get("more"):
                listing = call("page.get", {"ref":shelf["more"]})
                if listing.get("next"): call("page.get", {"ref":listing["next"]})
        for shelf in personal.get("shelves",[]):
            if shelf.get("id") == "mixes":
                for item in shelf["items"]: call("playlist.get", {"ref":item["ref"]})
        radio = next((i for shelf in personal.get("shelves",[]) if shelf.get("id") == "radio" for i in shelf.get("items",[])), None)
        if radio: call("playlist.get", {"ref":radio["ref"]})
        if home.get("genres"):
            call("page.get", {"ref":"discover:editors:"+str(home["genres"][0]["id"])})
    finally:
        process.stdin.close()
        try: process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.terminate()
            process.wait(timeout=5)
