#!/usr/bin/env python3
"""Check playlist actions against caller-supplied host components."""
import argparse
from pathlib import Path
import subprocess
import sys
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('host', type=Path)
parser.add_argument('--host-module', required=True)
parser.add_argument('--patterns-url', required=True)
args = parser.parse_args()
fixture = Path(__file__).resolve().parents[1] / 'tests/qml/tst_playlists.qml'
with tempfile.TemporaryDirectory(prefix='source-playlist-ui-') as directory:
    target = Path(directory) / 'tst_playlists.qml'
    target.write_text(fixture.read_text().replace('@HOST_SOURCES_MODULE@', args.host_module).replace('@HOST_PATTERNS@', args.patterns_url))
    raise SystemExit(subprocess.call([sys.executable, str(args.host.resolve() / 'scripts/test-qml.py'), str(target)]))
